---
import OverviewPanel from "../components/OverviewPanel.astro";
import DockerPanel from "../components/DockerPanel.astro";
import ProjectsPanel from "../components/ProjectsPanel.astro";
import ApplicationsPanel from "../components/ApplicationsPanel.astro";
import MonitoringPanel from "../components/MonitoringPanel.astro";
import DomainsPanel from "../components/DomainsPanel.astro";
import LogsPanel from "../components/LogsPanel.astro";
import TasksPanel from "../components/TasksPanel.astro";
import SecurityPanel from "../components/SecurityPanel.astro";
import SystemPanel from "../components/SystemPanel.astro";
import SettingsPanel from "../components/SettingsPanel.astro";
import AccessHeader from "../components/AccessHeader.astro";
import DashboardHeader from "../components/DashboardHeader.astro";
import DashboardDialogs from "../components/DashboardDialogs.astro";
import "../styles/tailwind.css";
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <title>VPS Manager</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main class="shell mx-auto w-[calc(100%_-_40px)] max-w-[1120px] py-12 max-[720px]:w-[calc(100%_-_32px)] max-[720px]:max-w-none max-[720px]:py-6">
      <AccessHeader />

      <section id="dashboard-view" class="hidden">
        <DashboardHeader />
        <div class="dashboard-panels">
          <OverviewPanel />
          <DockerPanel />
          <ProjectsPanel />
          <ApplicationsPanel />
          <MonitoringPanel />
          <DomainsPanel />
          <LogsPanel />
          <TasksPanel />
          <SecurityPanel />
          <SystemPanel />
          <SettingsPanel />
        </div>
        <p class="footnote">Vista de consulta con reinicio y escalado controlados de servicios administrados por VPS Manager.</p>
      </section>
    </main>

    <DashboardDialogs />
    <script is:inline type="module" src="/login.js"></script>
    <script is:inline type="module" src="/app.js"></script>
    <script is:inline type="module" src="/project-import.js"></script>
    <script>
      import "../scripts/hydrate-dashboard-tabs.js";
    </script>
  </body>
</html>
