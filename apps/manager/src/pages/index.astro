---
import DashboardTabs from "../components/DashboardTabs.jsx";
import ApplicationCatalog from "../components/ApplicationCatalog.jsx";
import "../styles/tailwind.css";
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <title>VPS Manager</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main class="shell mx-auto w-[calc(100%_-_40px)] max-w-[1120px] py-12 max-[720px]:w-[calc(100%_-_32px)] max-[720px]:max-w-none max-[720px]:py-6">
      <header class="topbar">
        <div>
          <p class="eyebrow">INFRAESTRUCTURA</p>
          <h1>VPS Manager</h1>
        </div>
        <button id="logout" class="button secondary hidden" type="button">Cerrar sesión</button>
      </header>

      <section id="login-view" class="card login-card">
        <p class="eyebrow">ACCESO ADMINISTRATIVO</p>
        <h2>Inicia sesión</h2>
        <p class="muted">Usa la contraseña de administrador configurada durante la instalación.</p>
        <form id="login-form">
          <label for="password">Contraseña</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required>
          <button class="button" type="submit">Entrar</button>
          <p id="login-error" class="error" role="alert"></p>
        </form>
      </section>

      <section id="dashboard-view" class="hidden">
        <div class="section-heading">
          <div>
            <p class="eyebrow">ADMINISTRACIÓN</p>
            <h2>Panel de control</h2>
          </div>
          <button id="refresh" class="button secondary" type="button">Actualizar</button>
        </div>
        <p id="status-message" class="muted" aria-live="polite"></p>
        <div id="dashboard-tabs-root"><DashboardTabs /></div>
        <div class="dashboard-panels">
          <section id="tab-overview" class="dashboard-panel" role="tabpanel" aria-labelledby="tab-button-overview" tabindex="0">
            <div class="grid grid-cols-1 gap-[18px] min-[721px]:grid-cols-2">
              <section class="card server-card">
                <div class="card-heading">
                  <h3>Servidor</h3>
                  <span id="swarm-state" class="badge">—</span>
                </div>
                <div id="server-info" class="server-details"></div>
              </section>
              <section class="card">
                <p class="eyebrow">CENTRO DE CONTROL</p>
                <h3>Resumen de VPS Manager</h3>
                <p class="muted tab-description">Usa las categorías para consultar recursos Docker, monitoreo, seguridad y mantenimiento. Las secciones marcadas como próximas son el esqueleto de las funciones planeadas, no funciones disponibles todavía.</p>
              </section>
              <section class="card" aria-labelledby="swarm-nodes-title">
                <div class="card-heading">
                  <h3 id="swarm-nodes-title">Nodos Swarm</h3>
                  <button id="refresh-nodes" class="button secondary" type="button">Actualizar</button>
                </div>
                <p id="nodes-status" class="muted" role="status" aria-live="polite">Consultando nodos…</p>
                <div id="swarm-nodes-list" class="resource-list"></div>
                <details class="node-enroll-details">
                  <summary>Incorporar VPS por SSH</summary>
                  <form id="node-enroll-form" class="form-stack">
                    <p class="muted">Solo Ubuntu Server 24.04. El panel instalará Docker y añadirá reglas UFW para el tráfico Swarm en la red privada. UFW debe estar activo en el manager y el destino; no se habilita ni se reinicia automáticamente. Asegúrate de permitir esos puertos también en el firewall del proveedor y en los nodos ya existentes.</p>
                    <label for="node-address">IP privada del VPS destino</label>
                    <input id="node-address" name="address" type="text" inputmode="decimal" placeholder="10.10.0.12" required>
                    <label for="node-manager-address">IP privada anunciada por el manager</label>
                    <input id="node-manager-address" name="managerAddress" type="text" inputmode="decimal" placeholder="10.10.0.2" required>
                    <label for="node-private-cidr">CIDR privada de la VPN/red</label>
                    <input id="node-private-cidr" name="privateCidr" type="text" inputmode="decimal" placeholder="10.10.0.0/24" required>
                    <label for="node-role">Rol Swarm</label>
                    <select id="node-role" name="role" required>
                      <option value="worker">Worker (recomendado)</option>
                      <option value="manager">Manager</option>
                    </select>
                    <label for="node-ssh-user">Usuario SSH (requiere sudo sin contraseña)</label>
                    <input id="node-ssh-user" name="sshUser" type="text" value="vpsadmin" pattern="[a-z_][a-z0-9_\x2d]{0,31}" required>
                    <label for="node-ssh-port">Puerto SSH</label>
                    <input id="node-ssh-port" name="sshPort" type="number" min="1" max="65535" value="22" required>
                    <label for="node-host-fingerprint">Fingerprint SSH verificado desde la consola del VPS</label>
                    <input id="node-host-fingerprint" name="hostFingerprint" type="text" placeholder="SHA256:…" pattern="SHA256:[A-Za-z0-9+\x2f]{43}" required>
                    <label for="node-private-key">Llave privada SSH dedicada y sin passphrase</label>
                    <textarea id="node-private-key" name="privateKey" rows="6" autoComplete="off" spellcheck="false" required></textarea>
                    <p class="muted">La llave se guarda temporalmente en el manager, fuera de PostgreSQL, tareas y auditoría; se elimina al terminar. La cuenta SSH podrá ejecutar comandos como root mediante sudo. No ingreses una llave personal.</p>
                    <p id="node-enroll-status" class="muted" role="status" aria-live="polite"></p>
                    <button id="node-enroll-submit" class="button" type="submit">Instalar Docker y unir al Swarm</button>
                  </form>
                </details>
              </section>
            </div>
          </section>

          <section id="tab-docker" class="dashboard-panel hidden" role="tabpanel" aria-labelledby="tab-button-docker" tabindex="0" hidden>
            <div class="grid grid-cols-1 gap-[18px] min-[721px]:grid-cols-2">
              <section class="card">
                <div class="card-heading">
                  <h3>Stacks</h3>
                  <span id="stack-count" class="badge" aria-label="0 visibles de 0">0</span>
                </div>
                <div class="resource-filters">
                  <label class="visually-hidden" for="stack-search">Buscar stacks</label>
                  <input id="stack-search" class="resource-search" type="search" placeholder="Buscar stacks o servicios…" autocomplete="off">
                  <label class="visually-hidden" for="stack-filter">Filtrar stacks por cantidad de servicios</label>
                  <select id="stack-filter" class="resource-filter">
                    <option value="all">Todos los tamaños</option>
                    <option value="single">Un servicio</option>
                    <option value="multiple">Varios servicios</option>
                  </select>
                </div>
                <div id="stacks" class="resource-list"></div>
              </section>
              <section class="card">
                <div class="card-heading">
                  <h3>Contenedores</h3>
                  <span id="container-count" class="badge" aria-label="0 visibles de 0">0</span>
                </div>
                <div class="resource-filters">
                  <label class="visually-hidden" for="container-search">Buscar contenedores</label>
                  <input id="container-search" class="resource-search" type="search" placeholder="Buscar nombre, imagen o ID…" autocomplete="off">
                  <label class="visually-hidden" for="container-filter">Filtrar contenedores por estado</label>
                  <select id="container-filter" class="resource-filter">
                    <option value="all">Todos los estados</option>
                    <option value="running">En ejecución</option>
                    <option value="inactive">No activos</option>
                  </select>
                </div>
                <div id="containers" class="resource-list"></div>
              </section>
              <section class="card">
                <div class="card-heading">
                  <h3>Servicios Swarm</h3>
                  <span id="service-count" class="badge" aria-label="0 visibles de 0">0</span>
                </div>
                <div class="resource-filters">
                  <label class="visually-hidden" for="service-search">Buscar servicios Swarm</label>
                  <input id="service-search" class="resource-search" type="search" placeholder="Buscar nombre o imagen…" autocomplete="off">
                  <label class="visually-hidden" for="service-filter">Filtrar servicios por modo</label>
                  <select id="service-filter" class="resource-filter">
                    <option value="all">Todos los modos</option>
                    <option value="replicado">Replicado</option>
                    <option value="global">Global</option>
                  </select>
                </div>
                <p id="service-operation-status" class="muted operation-status" aria-live="polite">Los controles solo operan servicios administrados; Swarm repone automáticamente las tareas detenidas.</p>
                <div id="services" class="resource-list"></div>
              </section>
              <section class="card roadmap-card">
                <div class="card-heading"><h3>Otros recursos Docker</h3><span class="badge roadmap-badge">Próximamente</span></div>
                <p class="muted">Estas vistas se habilitarán en siguientes fases del roadmap.</p>
                <ul class="roadmap-list"><li>Redes Docker</li><li>Volúmenes</li><li>Imágenes</li><li>Más operaciones controladas sobre contenedores y servicios</li></ul>
              </section>
            </div>
          </section>

          <section id="tab-projects" class="dashboard-panel hidden" role="tabpanel" aria-labelledby="tab-button-projects" tabindex="0" hidden>
            <div class="grid grid-cols-1 gap-[18px]">
              <section class="card" aria-labelledby="projects-title">
                <div class="card-heading">
                  <div>
                    <p class="eyebrow">DESPLIEGUE DE CÓDIGO</p>
                    <h3 id="projects-title">Proyectos</h3>
                  </div>
                  <button id="refresh-projects" class="button secondary" type="button">Actualizar</button>
                </div>
                <p class="muted">Conecta GitHub para elegir un repositorio y desplegar sus cambios automáticamente, o arrastra un ZIP/carpeta para crear un proyecto con sus archivos.</p>
                <p id="projects-status" class="muted" role="status" aria-live="polite">Cargando proyectos…</p>
                <div id="projects-list" class="project-list"></div>
                <section class="project-import" aria-labelledby="project-upload-title">
                  <h4 id="project-upload-title">Crear proyecto desde archivos</h4>
                  <div id="project-dropzone" class="project-dropzone" tabindex="0">
                    <strong>Arrastra aquí un archivo ZIP o una carpeta</strong>
                    <span class="muted">También puedes elegir archivos desde tu dispositivo. Máximo 32 MiB; el ZIP debe contener una sola carpeta raíz.</span>
                    <div class="project-actions">
                      <label class="button secondary project-file-button" for="project-zip-input">Elegir ZIP</label>
                      <input id="project-zip-input" class="visually-hidden" type="file" accept=".zip,application/zip">
                      <label class="button secondary project-file-button" for="project-folder-input">Elegir carpeta</label>
                      <input id="project-folder-input" class="visually-hidden" type="file" webkitdirectory directory multiple>
                    </div>
                  </div>
                  <p id="project-upload-status" class="muted" role="status" aria-live="polite"></p>
                </section>
              </section>

              <section class="card" aria-labelledby="github-settings-title">
                <details id="github-settings">
                  <summary id="github-settings-title">Configuración de GitHub OAuth</summary>
                  <p id="github-status" class="muted" role="status" aria-live="polite">Consultando conexión…</p>
                  <form id="github-config-form" class="form-stack">
                    <label for="github-client-id">Client ID</label>
                    <input id="github-client-id" name="clientId" autocomplete="off" required>
                    <label for="github-client-secret">Client Secret</label>
                    <input id="github-client-secret" name="clientSecret" type="password" autocomplete="new-password" required>
                    <label for="github-webhook-secret">Webhook secret</label>
                    <input id="github-webhook-secret" name="webhookSecret" type="password" minlength="20" autocomplete="new-password" required>
                    <p class="muted">Crea una OAuth App en GitHub. URL de callback: <code id="github-callback-url"></code>. El panel solicitará los permisos <code>repo</code> y <code>admin:repo_hook</code> para leer código privado y configurar actualizaciones automáticas. Los secretos se cifran en este VPS; los webhooks requieren una URL pública HTTPS y los despliegues requieren configurar el registro privado.</p>
                    <button class="button" type="submit">Guardar configuración OAuth</button>
                  </form>
                </details>
                <div class="project-import">
                  <div class="card-heading">
                    <h4>Importar desde GitHub</h4>
                    <button id="github-install" class="button secondary" type="button">Conectar cuenta</button>
                  </div>
                  <form id="github-import-form" class="form-stack">
                    <label for="project-installation">Cuenta conectada</label>
                    <select id="project-installation" name="accountId" required></select>
                    <label for="project-repository">Repositorio</label>
                    <select id="project-repository" name="repository" required></select>
                    <label for="project-production-branch">Rama de producción</label>
                    <select id="project-production-branch" name="productionBranch" required></select>
                    <button id="github-import-project" class="button" type="submit">Importar y desplegar</button>
                    <p id="github-import-status" class="muted" role="status" aria-live="polite"></p>
                  </form>
                </div>
              </section>
            </div>

            <dialog id="project-dialog" class="logs-dialog project-dialog">
              <div class="card-heading">
                <h3 id="project-dialog-title">Configuración del proyecto</h3>
                <button id="project-dialog-close" class="button secondary" type="button" aria-label="Cerrar">Cerrar</button>
              </div>
              <form id="project-form" class="form-stack">
                <input id="project-id" type="hidden">
                <label for="project-name">Nombre</label>
                <input id="project-name" name="name" maxlength="100" required>
                <label for="project-description">Descripción</label>
                <textarea id="project-description" name="description" rows="2" maxlength="500"></textarea>
                <label for="project-build-strategy">Método de build</label>
                <select id="project-build-strategy" name="buildStrategy">
                  <option value="dockerfile">Dockerfile</option>
                  <option value="railpack">Railpack (autodetección)</option>
                </select>
                <label for="project-build-context">Directorio de contexto</label>
                <input id="project-build-context" name="buildContext" value="." pattern="[A-Za-z0-9._\x2f\x2d]{1,255}" required>
                <div id="project-dockerfile-field">
                  <label for="project-dockerfile">Ruta del Dockerfile</label>
                  <input id="project-dockerfile" name="dockerfilePath" value="Dockerfile" pattern="[A-Za-z0-9._\x2f\x2d]{1,255}" required>
                </div>
                <label for="project-port">Puerto interno de la aplicación</label>
                <input id="project-port" name="internalPort" type="number" min="1" max="65535" value="3000" required>
                <label class="checkbox-label"><input id="project-auto-deploy" name="autoDeploy" type="checkbox" checked> Desplegar automáticamente al recibir pushes en la rama</label>
                <p id="project-form-status" class="muted" role="status" aria-live="polite"></p>
                <div class="project-actions">
                  <button id="project-save" class="button" type="submit">Guardar proyecto</button>
                  <button class="button secondary" type="button" data-close-project-dialog>Cancelar</button>
                </div>
              </form>
            </dialog>
          </section>

          <section id="tab-apps" class="dashboard-panel hidden" role="tabpanel" aria-labelledby="tab-button-apps" tabindex="0" hidden>
            <ApplicationCatalog />
            <div class="grid grid-cols-1 gap-[18px] min-[721px]:grid-cols-2">
              <section class="card roadmap-card">
                <div class="card-heading"><h3>Más aplicaciones</h3><span class="badge roadmap-badge">En preparación</span></div>
                <p class="muted">La estructura del catálogo ya admite entradas con características, acceso y estado de instalación.</p>
                <ul class="roadmap-list"><li>Catálogo con configuración declarativa</li><li>n8n, PostgreSQL y Redis</li><li>Supabase y aplicaciones multicontenedor</li><li>Variables, dominios y persistencia por aplicación</li></ul>
              </section>
            </div>
          </section>

          <section id="tab-monitoring" class="dashboard-panel hidden" role="tabpanel" aria-labelledby="tab-button-monitoring" tabindex="0" hidden>
            <div class="grid grid-cols-1 gap-[18px] min-[721px]:grid-cols-2">
              <section class="card backups-card">
                <div class="card-heading">
                  <h3>Uso e históricos de contenedores</h3>
                  <div class="container-heading-actions">
                    <button id="refresh-metrics" class="button secondary resource-action" type="button">Actualizar CPU/RAM</button>
                    <button id="refresh-history" class="button secondary resource-action" type="button">Actualizar histórico</button>
                  </div>
                </div>
                <p id="metrics-status" class="muted metrics-status" aria-live="polite"></p>
                <div id="metrics-groups" class="metrics-groups hidden" aria-live="polite"></div>
                <section class="metrics-history" aria-labelledby="metrics-history-title">
                  <div class="history-heading"><h4 id="metrics-history-title">Histórico · últimas 24 horas</h4></div>
                  <form id="metrics-settings-form" class="metrics-settings">
                    <label for="metrics-interval">Muestreo automático (minutos)</label>
                    <div class="metrics-settings-controls">
                      <input id="metrics-interval" name="intervalMinutes" type="number" min="1" max="1440" step="1" required>
                      <button class="button secondary resource-action" type="submit">Guardar</button>
                    </div>
                    <label for="metrics-cpu-threshold">Alerta CPU por contenedor (%)</label>
                    <input id="metrics-cpu-threshold" name="cpuPercent" type="number" min="1" max="10000" step="1" required>
                    <label for="metrics-memory-threshold">Alerta RAM del límite (%)</label>
                    <input id="metrics-memory-threshold" name="memoryPercent" type="number" min="1" max="100" step="1" required>
                    <label for="metrics-disk-threshold">Alerta de disco libre (%)</label>
                    <input id="metrics-disk-threshold" name="diskFreePercent" type="number" min="1" max="99" step="1" required>
                    <label for="metrics-restart-count">Reinicios en la ventana</label>
                    <input id="metrics-restart-count" name="restartCount" type="number" min="1" max="100" step="1" required>
                    <label for="metrics-restart-window">Ventana de reinicios (minutos)</label>
                    <input id="metrics-restart-window" name="restartWindowMinutes" type="number" min="5" max="1440" step="1" required>
                    <label for="metrics-http-timeout">Timeout HTTP (segundos)</label>
                    <input id="metrics-http-timeout" name="httpTimeoutSeconds" type="number" min="1" max="30" step="1" required>
                    <label for="metrics-certificate-days">Avisar antes de vencer (días)</label>
                    <input id="metrics-certificate-days" name="certificateWarningDays" type="number" min="1" max="90" step="1" required>
                    <p id="metrics-settings-status" class="muted" aria-live="polite">Retención: 7 días.</p>
                  </form>
                  <p id="history-status" class="muted" aria-live="polite"></p>
                  <p id="history-empty" class="muted hidden">Aún no hay muestras históricas.</p>
                  <div id="history-legend" class="history-legend"></div>
                  <div id="history-charts" class="history-charts hidden">
                    <div><h5>CPU (%)</h5><svg id="cpu-history-chart" class="history-chart" viewBox="0 0 640 190" role="img" aria-label="Histórico de uso de CPU por grupo"></svg></div>
                    <div><h5>Memoria (GiB)</h5><svg id="memory-history-chart" class="history-chart" viewBox="0 0 640 190" role="img" aria-label="Histórico de memoria por grupo"></svg></div>
                  </div>
                </section>
              </section>
              <section class="card backups-card metric-alerts-card" aria-labelledby="metric-alerts-title">
                <h3 id="metric-alerts-title">Alertas activas</h3>
                <p class="muted metric-alert-note">Se comprueban las rutas Host de Traefik con GET /. HTTP considera sanas respuestas 2xx/3xx; timeout predeterminado 5 s. Los certificados TLS avisan 14 días antes. El disco corresponde al filesystem visible para el panel. Sin email ni webhooks.</p>
                <p id="metric-alerts-status" class="muted" aria-live="polite"></p>
                <ul id="metric-alerts" class="metric-alert-list" aria-live="polite"></ul>
              </section>
              <section class="card roadmap-card">
                <div class="card-heading"><h3>Monitoreo ampliado</h3><span class="badge roadmap-badge">Próximamente</span></div>
                <p class="muted">El roadmap contempla Prometheus, cAdvisor, Node Exporter y canales configurables para notificaciones de alertas.</p>
              </section>
            </div>
          </section>

          <section id="tab-domains" class="dashboard-panel hidden" role="tabpanel" aria-labelledby="tab-button-domains" tabindex="0" hidden>
            <div class="grid grid-cols-1 gap-[18px]">
              <section class="card roadmap-card">
                <div class="card-heading">
                  <div>
                    <h3>Dominios conectados</h3>
                    <p class="muted">Registra aquí tus dominios raíz para tenerlos disponibles cuando habilitemos su uso en aplicaciones y proyectos. No se crean subdominios ni se asignan dominios a proyectos desde esta vista.</p>
                  </div>
                  <div class="container-heading-actions">
                    <button id="open-domain-zone-dialog" class="button resource-action" type="button">Conectar nuevo dominio</button>
                    <button id="refresh-domains" class="button secondary resource-action" type="button">Actualizar</button>
                  </div>
                </div>
                <p class="muted">Por ahora, VPS Manager verifica y administra zonas de Cloudflare. Puedes haber comprado el dominio en otro registrador si lo delegaste a Cloudflare.</p>
                <p class="muted">El estado confirma si el token funciona y la zona está activa en Cloudflare. No comprueba la propagación DNS pública ni HTTPS.</p>
                <p id="domain-zones-status" class="muted" role="status" aria-live="polite">Consultando dominios…</p>
                <div id="domain-zones-list" class="resource-list"></div>
              </section>
              <section class="card backups-card">
                <h3>Guía para conectar un dominio con Cloudflare</h3>
                <ol class="roadmap-list">
                  <li><strong>Añade el dominio a Cloudflare.</strong> En Cloudflare, elige agregar un sitio e introduce el dominio raíz, por ejemplo <code>midominio.com</code>. No introduzcas un subdominio.</li>
                  <li><strong>Confirma los registros DNS.</strong> Revisa o importa los registros que Cloudflare detecte. Mantén los registros existentes que necesites para tu web y correo.</li>
                  <li><strong>Actualiza los nameservers en tu registrador.</strong> Cloudflare te mostrará dos nameservers asignados. En el panel donde compraste el dominio (por ejemplo, Namecheap), reemplaza los nameservers actuales por esos dos valores.</li>
                  <li><strong>Espera a que Cloudflare active la zona.</strong> La propagación puede tardar. En Cloudflare, el estado del dominio debe aparecer como <em>Active</em> antes de continuar.</li>
                  <li><strong>Crea un token de API.</strong> En el perfil de Cloudflare, crea un token personalizado con permiso <code>Zone:Read</code> y <code>DNS:Edit</code> limitado a la zona que vas a conectar. No compartas el token.</li>
                  <li><strong>Conéctalo en VPS Manager.</strong> Pulsa <em>Conectar nuevo dominio</em>, escribe el dominio raíz y pega el token. El panel verifica que la zona activa esté disponible en esa cuenta y guarda el token de forma protegida en el VPS.</li>
                </ol>
                <p class="muted">Esta conexión solo registra la zona y las credenciales de Cloudflare. No cambia registros DNS ni asigna el dominio a un proyecto. La asignación se hará en un paso posterior.</p>
              </section>
            </div>
          </section>

          <section id="tab-logs" class="dashboard-panel hidden" role="tabpanel" aria-labelledby="tab-button-logs" tabindex="0" hidden>
            <div class="grid grid-cols-1 gap-[18px] min-[721px]:grid-cols-2">
              <section class="card roadmap-card">
                <div class="card-heading"><h3>Logs</h3><span class="badge">Disponible en Docker</span></div>
                <p class="muted">Los logs actuales se consultan desde cada contenedor o servicio: abre la pestaña Docker y usa el botón “Ver logs”.</p>
                <p class="muted">La búsqueda unificada, filtros por fecha y registros de operaciones persistentes se incorporarán en una fase posterior.</p>
              </section>
            </div>
          </section>

          <section id="tab-tasks" class="dashboard-panel hidden" role="tabpanel" aria-labelledby="tab-button-tasks" tabindex="0" hidden>
            <div class="grid grid-cols-1 gap-[18px] min-[721px]:grid-cols-2">
              <section class="card backups-card">
                <div class="card-heading">
                  <h3>Tareas y operaciones</h3>
                  <button id="refresh-tasks" class="button secondary resource-action" type="button">Actualizar</button>
                </div>
                <p id="tasks-status" class="muted" aria-live="polite">Cola persistente, intentos y resultados de las operaciones.</p>
                <div id="tasks-list" class="resource-list"></div>
              </section>
              <section class="card roadmap-card">
                <div class="card-heading"><h3>Próximas mejoras</h3><span class="badge roadmap-badge">En desarrollo</span></div>
                <p class="muted">La cola se guarda en PostgreSQL y recupera las tareas con leases vencidas. Actualmente permite reinicios y escalados limitados de servicios administrados.</p>
                <ul class="roadmap-list"><li>Agregar handlers explícitos para nuevas clases de operaciones</li><li>Seguimiento de progreso detallado</li><li>Cancelación segura para operaciones compatibles</li></ul>
              </section>
            </div>
          </section>

          <section id="tab-security" class="dashboard-panel hidden" role="tabpanel" aria-labelledby="tab-button-security" tabindex="0" hidden>
            <div class="grid grid-cols-1 gap-[18px] min-[721px]:grid-cols-2">
              <section class="card backups-card" aria-labelledby="backups-title">
                <div class="card-heading">
                  <h3 id="backups-title">Respaldos de PostgreSQL</h3>
                  <div class="container-heading-actions">
                    <button id="refresh-backups" class="button secondary resource-action" type="button">Actualizar</button>
                    <button id="create-backup" class="button resource-action" type="button">Crear respaldo</button>
                  </div>
                </div>
                <p class="muted backup-note">Archivos cifrados en este VPS. La clave de cifrado se mostró una sola vez durante la instalación; consérvala fuera del servidor.</p>
                <form id="backup-settings-form" class="backup-settings">
                  <label for="backup-interval">Respaldo automático cada (horas)</label>
                  <div class="metrics-settings-controls">
                    <input id="backup-interval" name="intervalHours" type="number" min="1" max="168" step="1" required>
                    <button class="button secondary resource-action" type="submit">Guardar</button>
                  </div>
                  <p id="backup-settings-status" class="muted" aria-live="polite">Retención: 7 días.</p>
                </form>
                <p id="backups-status" class="muted" aria-live="polite"></p>
                <div id="backups-list" class="resource-list"></div>
              </section>
              <section class="card backups-card" aria-labelledby="audit-title">
                <div class="card-heading">
                  <h3 id="audit-title">Auditoría reciente</h3>
                  <button id="refresh-audit" class="button secondary resource-action" type="button">Actualizar</button>
                </div>
                <p class="muted backup-note">Últimas 100 operaciones relevantes. No incluye credenciales ni claves.</p>
                <p id="audit-status" class="muted" aria-live="polite"></p>
                <div id="audit-list" class="resource-list"></div>
              </section>
              <section class="card roadmap-card">
                <div class="card-heading"><h3>Acceso y recuperación</h3><span class="badge roadmap-badge">Próximamente</span></div>
                <p class="muted">Los respaldos cifrados y la auditoría ya están disponibles. El roadmap de seguridad continúa con:</p>
                <ul class="roadmap-list"><li>Roles y permisos para más de un administrador</li><li>Autenticación multifactor (MFA)</li><li>Recuperación automática ante fallos</li></ul>
              </section>
            </div>
          </section>

          <section id="tab-system" class="dashboard-panel hidden" role="tabpanel" aria-labelledby="tab-button-system" tabindex="0" hidden>
            <div class="grid grid-cols-1 gap-[18px] min-[721px]:grid-cols-2">
              <section class="card backups-card" aria-labelledby="diagnostics-title">
                <div class="card-heading">
                  <h3 id="diagnostics-title">Diagnóstico del sistema</h3>
                  <button id="refresh-diagnostics" class="button secondary resource-action" type="button">Ejecutar diagnóstico</button>
                </div>
                <p id="diagnostics-status" class="muted" aria-live="polite">Aún no se ha ejecutado.</p>
                <div id="diagnostics-list" class="diagnostic-list" aria-live="polite"></div>
                <p class="muted diagnostic-note">El panel comprueba Docker, Swarm, servicios, redes, PostgreSQL y respaldos. Para detalles del sistema operativo, disco y puertos, ejecuta <code>sudo vps-manager-diagnostics</code> por SSH.</p>
              </section>
              <section class="card backups-card" aria-labelledby="updates-title">
                <div class="card-heading">
                  <h3 id="updates-title">Actualizaciones de VPS Manager</h3>
                  <button id="check-updates" class="button secondary resource-action" type="button">Buscar actualización</button>
                </div>
                <p id="updates-status" class="muted" aria-live="polite">Versión instalada: —</p>
                <p id="updates-release-notes" class="muted update-release-notes"></p>
                <p id="web-update-status" class="muted update-job-status" aria-live="polite">No hay una actualización web en curso.</p>
                <div id="updates-action" class="update-action hidden">
                  <button id="start-web-update" class="button resource-action" type="button">Actualizar desde el panel</button>
                  <details class="update-manual">
                    <summary>Usar el comando SSH manual</summary>
                    <div class="update-action">
                      <code id="update-command">sudo vps-manager-update</code>
                      <button id="copy-update-command" class="button secondary resource-action" type="button">Copiar comando</button>
                    </div>
                  </details>
                </div>
                <p class="muted update-note">La actualización web solicita una tarea fija al servicio host de systemd; no permite enviar comandos ni versiones y no concede acceso Docker de escritura al panel. También puedes ejecutarla manualmente por SSH.</p>
              </section>
            </div>
          </section>

          <section id="tab-settings" class="dashboard-panel hidden" role="tabpanel" aria-labelledby="tab-button-settings" tabindex="0" hidden>
            <div class="grid grid-cols-1 gap-[18px] min-[721px]:grid-cols-2">
              <section class="card backups-card" aria-labelledby="registry-title">
                <div class="card-heading">
                  <h3 id="registry-title">Registro privado de imágenes</h3>
                  <span id="registry-state" class="badge">Sin configurar</span>
                </div>
                <p id="registry-status" class="muted" aria-live="polite">La configuración se realiza aquí después de instalar VPS Manager.</p>
                <form id="registry-configure-form" class="form-stack">
                  <label for="registry-domain">Dominio del registro</label>
                  <input id="registry-domain" name="domain" type="text" inputmode="url" autocomplete="url" placeholder="registry.ejemplo.com" pattern="(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9\x2d]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}" required>
                  <p class="muted">Configura primero un registro DNS A que apunte al VPS. Traefik emitirá un certificado HTTPS para este dominio.</p>
                  <label for="registry-username">Usuario</label>
                  <input id="registry-username" name="username" type="text" pattern="[A-Za-z0-9._\x2d]{1,64}" maxLength="64" autocomplete="username" required>
                  <label for="registry-password">Contraseña nueva</label>
                  <input id="registry-password" name="password" type="password" pattern="[A-Za-z0-9._\x2d]{20,72}" minLength="20" maxLength="72" autocomplete="new-password" required>
                  <p class="muted">Usa de 20 a 72 caracteres. La contraseña se conserva en un archivo root-only del host y su hash bcrypt en un secreto Docker; nunca se vuelve a mostrar. Para cambiarla, ingresa una contraseña nueva.</p>
                  <p id="registry-form-status" class="muted" role="status" aria-live="polite"></p>
                  <button id="registry-save" class="button" type="submit">Configurar registro privado</button>
                </form>
              </section>
            </div>
          </section>
        </div>
        <p class="footnote">Vista de consulta con reinicio y escalado controlados de servicios administrados por VPS Manager.</p>
      </section>
    </main>
    <dialog id="domain-zone-dialog" class="logs-dialog restore-dialog" aria-labelledby="domain-zone-dialog-title">
      <div class="logs-heading">
        <div>
          <p class="eyebrow">CLOUDFLARE</p>
          <h2 id="domain-zone-dialog-title">Conectar dominio raíz</h2>
        </div>
        <button id="close-domain-zone-dialog" class="button secondary" type="button">Cerrar</button>
      </div>
      <form id="domain-zone-form">
        <input id="domain-zone-id" name="id" type="hidden">
        <label for="domain-zone-name">Dominio raíz</label>
        <input id="domain-zone-name" name="zone" type="text" placeholder="midominio.com" autocomplete="off" required>
        <label for="domain-zone-token">Token API de Cloudflare <span class="muted">(Zone:Read y DNS:Edit)</span></label>
        <input id="domain-zone-token" name="token" type="password" autocomplete="new-password" placeholder="Token de Cloudflare" required>
        <p class="muted">El token se guarda en el VPS con permisos restringidos y no se almacena en PostgreSQL.</p>
        <p id="domain-zone-form-status" class="muted" role="status" aria-live="polite"></p>
        <div class="dialog-actions">
          <button id="domain-zone-cancel" class="button secondary" type="button">Cancelar</button>
          <button id="domain-zone-save" class="button" type="submit">Conectar dominio</button>
        </div>
      </form>
    </dialog>
    <dialog id="logs-dialog" class="logs-dialog" aria-labelledby="logs-title">
      <div class="logs-heading">
        <div>
          <p class="eyebrow">CONSULTA · SOLO LECTURA</p>
          <h2 id="logs-title">Logs del contenedor</h2>
        </div>
        <button id="close-logs" class="button secondary" type="button">Cerrar</button>
      </div>
      <p id="logs-status" class="muted" aria-live="polite"></p>
      <pre id="logs-content" class="logs-content"></pre>
    </dialog>
    <dialog id="restore-dialog" class="logs-dialog restore-dialog" aria-labelledby="restore-title">
      <div class="logs-heading">
        <div>
          <p class="eyebrow">OPERACIÓN DESTRUCTIVA</p>
          <h2 id="restore-title">Restaurar base de datos</h2>
        </div>
        <button id="close-restore" class="button secondary" type="button">Cancelar</button>
      </div>
      <p class="muted">Esta acción reemplaza datos de la base de datos actual. Solo continúa si el respaldo y la clave de cifrado son correctos.</p>
      <form id="restore-form">
        <label for="restore-confirmation">Escribe RESTAURAR para confirmar</label>
        <input id="restore-confirmation" name="confirmation" type="text" autocomplete="off" required>
        <p id="restore-status" class="error" role="alert"></p>
        <div class="dialog-actions">
          <button id="cancel-restore" class="button secondary" type="button">Cancelar</button>
          <button id="confirm-restore" class="button danger" type="submit">Restaurar base de datos</button>
        </div>
      </form>
    </dialog>
    <dialog id="postgresql-credentials-dialog" class="logs-dialog" aria-labelledby="postgresql-credentials-title">
      <div class="logs-heading">
        <div>
          <p class="eyebrow">CREDENCIALES DE UN SOLO USO</p>
          <h2 id="postgresql-credentials-title">Acceso a PostgreSQL</h2>
        </div>
        <button id="close-postgresql-credentials" class="button secondary" type="button">Cerrar</button>
      </div>
      <p class="muted">Guarda estas credenciales en un gestor seguro ahora. La contraseña no se volverá a mostrar y caduca si no se consulta durante 30 minutos. Solo funciona desde servicios conectados a la red privada de Swarm.</p>
      <dl class="credentials-list">
        <dt>Host</dt><dd><code id="postgresql-credential-host"></code></dd>
        <dt>Puerto</dt><dd><code id="postgresql-credential-port"></code></dd>
        <dt>Base de datos</dt><dd><code id="postgresql-credential-database"></code></dd>
        <dt>Usuario</dt><dd><code id="postgresql-credential-username"></code></dd>
        <dt>Contraseña</dt><dd><code id="postgresql-credential-password"></code></dd>
      </dl>
      <div class="dialog-actions">
        <button id="copy-postgresql-credentials" class="button secondary" type="button">Copiar credenciales</button>
      </div>
    </dialog>
    <dialog id="supabase-configuration-dialog" class="logs-dialog restore-dialog" aria-labelledby="supabase-configuration-title">
      <div class="logs-heading">
        <div>
          <p class="eyebrow">CATÁLOGO DE APLICACIONES</p>
          <h2 id="supabase-configuration-title">Configuración de Supabase</h2>
        </div>
        <button id="close-supabase-configuration" class="button secondary" type="button">Cerrar</button>
      </div>
      <p class="muted">Guarda una configuración por VPS. Este formulario no guarda contraseñas, claves JWT ni secretos OAuth/SMTP; se generarán o cargarán como secretos Swarm al implementar el stack.</p>
      <form id="supabase-configuration-form">
        <label for="supabase-instance-name">Nombre de la instalación</label>
        <input id="supabase-instance-name" name="name" type="text" maxlength="100" required>
        <label for="supabase-server-node">VPS destino (nodo activo del Swarm)</label>
        <select id="supabase-server-node" name="serverNodeId" required></select>
        <label for="supabase-api-domain">Dominio HTTPS de API</label>
        <input id="supabase-api-domain" name="apiDomain" type="text" placeholder="api.ejemplo.com" autocomplete="off" required>
        <label for="supabase-studio-domain">Dominio HTTPS de Studio</label>
        <input id="supabase-studio-domain" name="studioDomain" type="text" placeholder="studio.ejemplo.com" autocomplete="off" required>
        <label for="supabase-site-url">URL del sitio que usará Supabase</label>
        <input id="supabase-site-url" name="siteUrl" type="url" placeholder="https://app.ejemplo.com" required>
        <label for="supabase-redirect-urls">URLs HTTPS adicionales de redirección (una por línea)</label>
        <textarea id="supabase-redirect-urls" name="additionalRedirectUrls" rows="3" placeholder="https://app.ejemplo.com/auth/callback"></textarea>
        <label for="supabase-organization-name">Organización inicial</label>
        <input id="supabase-organization-name" name="organizationName" type="text" maxlength="100" required>
        <label for="supabase-project-name">Proyecto inicial</label>
        <input id="supabase-project-name" name="projectName" type="text" maxlength="100" required>
        <fieldset class="application-fieldset">
          <legend>Autenticación</legend>
          <label class="checkbox-label" for="supabase-disable-signup"><input id="supabase-disable-signup" name="disableSignup" type="checkbox"> Deshabilitar registros</label>
          <label class="checkbox-label" for="supabase-email-signup"><input id="supabase-email-signup" name="enableEmailSignup" type="checkbox"> Registro por email</label>
          <label class="checkbox-label" for="supabase-email-autoconfirm"><input id="supabase-email-autoconfirm" name="enableEmailAutoconfirm" type="checkbox"> Confirmar emails automáticamente</label>
          <label class="checkbox-label" for="supabase-anonymous-users"><input id="supabase-anonymous-users" name="enableAnonymousUsers" type="checkbox"> Permitir usuarios anónimos</label>
          <label for="supabase-jwt-expiry">Duración JWT (segundos)</label>
          <input id="supabase-jwt-expiry" name="jwtExpirySeconds" type="number" min="300" max="604800" step="1" required>
        </fieldset>
        <fieldset class="application-fieldset">
          <legend>API, almacenamiento y funciones</legend>
          <label for="supabase-max-rows">Máximo de filas por consulta REST</label>
          <input id="supabase-max-rows" name="maxRows" type="number" min="1" max="10000" step="1" required>
          <label for="supabase-file-size">Límite de archivo en bytes</label>
          <input id="supabase-file-size" name="storageFileSizeLimitBytes" type="number" min="1048576" max="5368709120" step="1" required>
          <label for="supabase-storage-region">Región de almacenamiento</label>
          <input id="supabase-storage-region" name="storageRegion" type="text" maxlength="100" required>
          <label class="checkbox-label" for="supabase-image-transformation"><input id="supabase-image-transformation" name="enableImageTransformation" type="checkbox"> Habilitar transformación de imágenes</label>
          <label class="checkbox-label" for="supabase-functions-verify-jwt"><input id="supabase-functions-verify-jwt" name="functionsVerifyJwt" type="checkbox"> Verificar JWT en Edge Functions</label>
        </fieldset>
        <label for="supabase-smtp-settings">SMTP opcional (JSON sin contraseña)</label>
        <textarea id="supabase-smtp-settings" name="smtp" rows="3" placeholder='{"host":"smtp.ejemplo.com","port":587,"adminEmail":"admin@ejemplo.com","senderName":"Supabase","username":"usuario"}'></textarea>
        <label for="supabase-oauth-settings">Proveedores OAuth opcionales (JSON sin secretos de cliente)</label>
        <textarea id="supabase-oauth-settings" name="oauthProviders" rows="3" placeholder='{"github":{"enabled":true,"clientId":"..."} }'></textarea>
        <label for="supabase-resource-limits">CPU y memoria por servicio (JSON)</label>
        <textarea id="supabase-resource-limits" name="resourceLimits" rows="10" spellcheck="false" required></textarea>
        <p id="supabase-configuration-status" class="muted" role="status" aria-live="polite"></p>
        <div class="dialog-actions">
          <button id="save-supabase-configuration" class="button" type="submit">Guardar configuración del VPS</button>
        </div>
      </form>
    </dialog>
    <script is:inline type="module" src="/app.js"></script>
    <script>
      import "../scripts/hydrate-dashboard-tabs.js";
    </script>
  </body>
</html>
